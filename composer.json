{
	"name": "lesterchan/wp-useronline",
	"description": "Enable you to display how many users are online on your WordPress site.",
	"type": "wordpress-plugin",
	"homepage": "https://wordpress.org/plugins/wp-useronline/",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Lester Chan",
			"email": "lesterchan@gmail.com"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"phpstan/phpstan": "^2.2",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wp-cli-stubs": "dev-master",
		"php-stubs/wordpress-stubs": "^7.1"
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --memory-limit=2G"
	},
	"config": {
		"allow-plugins": false
	}
}
